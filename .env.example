# SaaS persistence
# Local dev without a database: "file:./dev.db"
# Production: a postgresql:// URL (pooled connection is fine here)
DATABASE_URL="file:./dev.db"
# Required only when DATABASE_URL is postgresql://. Must be the UNPOOLED
# connection string — Prisma migrations run against this, not the pooler.
DATABASE_URL_UNPOOLED=""

# Authentication. Generate a long random value for production.
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Billing. `mock` is for local development only.
PAYMENT_PROVIDER="stripe"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
BILLING_WEBHOOK_SECRET="replace-with-a-long-random-webhook-secret"

# Transactional email (verification, password reset, team invites).
# smtp(s)://user:pass@host:port — leave unset in local dev to log emails
# to the console instead of sending them.
SMTP_CONNECTION_URL=""
EMAIL_FROM="Centralia <no-reply@centralia.app>"

# Public application URL
APP_URL="http://localhost:3000"
