    "db:migrate:postgres": "prisma migrate deploy --schema=prisma/postgresql/schema.prisma",
    "db:seed": "tsx scripts/seed.ts",
    "test:api": "bash scripts/api-smoke.sh",
    "test:security": "bash scripts/security-smoke.sh",
    "test:auth": "bash scripts/auth-security-smoke.sh",
    "test:edge": "bash scripts/edge-cases-smoke.sh",
    "test:tenant": "bash scripts/tenant-isolation-smoke.sh",
    "test:subscription": "bash scripts/subscription-lifecycle-smoke.sh",
    "test:subscription-page": "bash scripts/subscription-page-smoke.sh",
    "test:account-pages": "bash scripts/account-pages-smoke.sh",
    "test:final-window-status": "bash scripts/final-window-status-smoke.sh",
    "test:auth-boundaries": "bash scripts/auth-error-boundary-audit.sh",
    "test:lms-independence": "bash scripts/lms-independence-audit.sh",
    "test:collection-bounds": "bash scripts/collection-bounds-audit.sh",
    "test:plans-degraded": "bash scripts/plans-degraded-smoke.sh",
    "test:regression-matrix": "bash scripts/regression-matrix.sh",
